<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>cn.iocoder.boot</groupId>
        <artifactId>yudao</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>keelbase-codegen</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        Turns a Business Spec into what this host needs for a governed module: the DDL that creates its
        table, and the two of our files that give it an AI tool face and a row-scope pointcut.
        把一份 Business Spec 变成这个宿主需要的两样东西：建表的 DDL，以及我们自己的两个文件——AI 工具面与行范围切点。
    </description>

    <dependencies>
        <!-- Only for reading the Spec. / 只为读 Spec。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- 以及冻结协议，只为一条常量：`RiskLevel.needsConfirmation` —— 「哪几级为人停下」的那条规则。Spec
             带一个 `requiresConfirmation` 布尔，但**风险级才是权威**（协议 §4），故生成器从这条规则的**出处**读它、
             而不是复述一遍。仅编译期：它产出的文本仍不依赖任何东西。版本与宿主的运行时依赖同档（`0.1.15`），
             免得这条规则哪天改了、生成器却按旧规矩行事。
             And the frozen protocol, for one constant: `RiskLevel.needsConfirmation` — the rule that says which
             levels stop for a human. A Spec carries a `requiresConfirmation` flag, but the risk level is the
             authority (protocol §4), so the generator reads the rule where it lives rather than restating it.
             Compile-time only: the text this emits still depends on nothing else. Kept on the same version as the
             host's runtime dependencies (`0.1.15`), so the rule cannot change under a generator still reading the old one. -->
        <dependency>
            <groupId>cn.com.keelbase</groupId>
            <artifactId>keelbase4j-protocol</artifactId>
            <version>0.1.15</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The generator is not a dependency of anything: it is run, not linked. `exec:java` keeps
                 it that way — no jar to install, no classpath to assemble, and the compile step is the
                 same one the rest of the build uses.
                 生成器不是谁的依赖：它是**被运行**的，不是被链接的。`exec:java` 保持这一点——没有要安装的 jar、
                 没有要拼的 classpath，而编译那一步与整个构建用的是同一步。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>cn.iocoder.yudao.codegen.SpecCodegen</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
