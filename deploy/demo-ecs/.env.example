# SPDX-License-Identifier: Apache-2.0
#
# Copy this to `.env` in the same directory and fill in both values. `.env` is git-ignored and must
# never be committed — one of the two values is a database password.
#
# 把它复制成同目录下的 `.env` 再填两个值。`.env` 已被 git 忽略，**绝不要**提交——其中一个是数据库口令。

# PG_PASSWORD — the password of the PostgreSQL role this stack connects as.
#   On the demo host that role is the one the host's own Postgres container was created with, so the
#   value is read off that running container rather than chosen here:
#
#     docker inspect keelbase-postgres-1 --format '{{range .Config.Env}}{{println .}}{{end}}' \
#       | sed -n 's/^POSTGRES_PASSWORD=//p'
#
# PG_PASSWORD —— 本栈所连的那个 PostgreSQL 角色的口令。
#   在 demo 机器上，那个角色就是宿主自己的 Postgres 容器建库时用的那个，所以这个值是从那个运行中的
#   容器上读出来的，不是在这里另选的；取法见上面的命令。

# AUDIT_KEY — the HMAC key for the runtime's audit chain.
#   Generate it once and then keep it stable: the chain is verified by recomputing hashes from it, so
#   replacing it makes every audit row written before the change fail verification.
#
#     openssl rand -hex 32
#
# AUDIT_KEY —— 运行时审计链的 HMAC 密钥。
#   **生成一次、之后保持不变**：链的验证要靠它重算哈希，所以换掉它会让此前写下的每一行审计都验不过。

PG_PASSWORD=replace-me
AUDIT_KEY=replace-me

# AI_ENABLED — set to `true` to drive KeelBase's `/ai/chat` and `/ai/task` from a real model.
#   Left unset (or false) the runtime answers from its deterministic planner, and `/ai/chat` reports
#   `provider: deterministic`. Turning it on without `MODEL_API_KEY` is not useful: the call fails at
#   request time, not at boot, so nothing warns you until something asks the model.
#
# AI_ENABLED —— 设为 `true` 让 KeelBase 的 `/ai/chat` 与 `/ai/task` 由**真模型**驱动。不设（或 false）
#   时运行时由确定性 planner 作答，`/ai/chat` 会报 `provider: deterministic`。开着却不给
#   `MODEL_API_KEY` 没有意义：失败发生在**请求时**而不是启动时，所以在有人真的去问模型之前不会有任何提示。

# MODEL_API_KEY / MODEL_BASE_URL / MODEL_NAME — the provider the loop talks to.
#   The default base URL and model are DeepSeek's; point them elsewhere to use another
#   OpenAI-compatible provider. `MODEL_NAME` must be a model that provider actually serves.
#
# MODEL_API_KEY / MODEL_BASE_URL / MODEL_NAME —— 回路所连的提供方。
#   默认的 base URL 与模型是 DeepSeek 的；换成别的、兼容 OpenAI 协议的提供方就改这两项。`MODEL_NAME`
#   必须是那个提供方真的提供的模型。

AI_ENABLED=true
MODEL_API_KEY=replace-me
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
